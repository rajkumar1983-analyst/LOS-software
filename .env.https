# ==========================================================================
# LOCAL HTTPS environment — everything dockerized, single entry via nginx on :443
# with the self-signed certs/localhost.{crt,key}. Browser reaches the frontend (/),
# API (/api, /dashboard) and Keycloak (/auth) all over https://localhost.
# Usage:  docker compose --env-file .env.https up -d --build
# Then open https://localhost (accept the self-signed cert warning once).
# ==========================================================================

# --- Frontend (baked into the Vite bundle at BUILD time via build args) ---
VITE_CUSTOMER_SERVICE_URL=https://localhost
VITE_LOAN_SERVICE_URL=https://localhost
VITE_AGGREGATOR_SERVICE_URL=https://localhost
VITE_KEYCLOAK_URL=https://localhost/auth
VITE_KEYCLOAK_REALM=los-realm
VITE_KEYCLOAK_CLIENT_ID=los-frontend

# --- Backend: fetch Keycloak signing keys over the internal docker network (HTTP) ---
# (Decoupled from the browser-facing https URL, so self-signed + localhost don't matter.)
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/auth/realms/los-realm/protocol/openid-connect/certs
CORS_ALLOWED_ORIGINS=https://localhost

# --- Keycloak served under /auth behind the nginx TLS proxy ---
KC_HTTP_RELATIVE_PATH=/auth

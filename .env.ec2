# ==========================================================================
# EC2 environment — everything dockerized, single entry point via nginx on :80.
# The browser reaches the frontend (/), the API (/api, /dashboard) and Keycloak
# (/auth) all through nginx on port 80.
# Usage:  docker compose --env-file .env.ec2 up -d --build
#
# Replace 65.2.128.166 with your EC2 public IP or DNS if it changes.
# ==========================================================================

# --- Frontend (baked into the Vite bundle at BUILD time via build args) ---
# All calls go to the EC2 host; nginx routes them to the right service.
VITE_CUSTOMER_SERVICE_URL=http://65.2.128.166
VITE_LOAN_SERVICE_URL=http://65.2.128.166
VITE_AGGREGATOR_SERVICE_URL=http://65.2.128.166
VITE_KEYCLOAK_URL=http://65.2.128.166/auth
VITE_KEYCLOAK_REALM=los-realm
VITE_KEYCLOAK_CLIENT_ID=los-frontend

# --- Backend: fetch Keycloak signing keys over the internal docker network (HTTP) ---
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/auth/realms/los-realm/protocol/openid-connect/certs
CORS_ALLOWED_ORIGINS=http://65.2.128.166

# --- Keycloak served under /auth so it can sit behind the nginx path proxy ---
KC_HTTP_RELATIVE_PATH=/auth

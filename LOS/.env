# Local `npm run dev` fallback (dev values).
# Dockerized builds get these from .env.dev / .env.ec2 via build args (see docker-compose.yml),
# which override anything here — so keep this file on the dev values.
VITE_CUSTOMER_SERVICE_URL=http://localhost:8080
VITE_LOAN_SERVICE_URL=http://localhost:8080
VITE_AGGREGATOR_SERVICE_URL=http://localhost:8080

VITE_KEYCLOAK_URL=http://keycloak.local:9090
VITE_KEYCLOAK_REALM=los-realm
VITE_KEYCLOAK_CLIENT_ID=los-frontend

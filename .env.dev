# ==========================================================================
# DEV environment — everything dockerized locally, each service on its own port.
# Usage:  docker compose --env-file .env.dev up -d --build
# ==========================================================================

# --- Frontend (baked into the Vite bundle at BUILD time via build args) ---
# Dev talks directly to the gateway (8080) and Keycloak (keycloak.local:9090).
VITE_CUSTOMER_SERVICE_URL=http://localhost:8080
VITE_LOAN_SERVICE_URL=http://localhost:8080
VITE_AGGREGATOR_SERVICE_URL=http://localhost:8080
VITE_KEYCLOAK_URL=http://keycloak.local:9090
VITE_KEYCLOAK_REALM=los-realm
VITE_KEYCLOAK_CLIENT_ID=los-frontend

# --- Backend: fetch Keycloak signing keys over the internal docker network (HTTP) ---
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/los-realm/protocol/openid-connect/certs
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Keycloak served at the root path on :9090 (no reverse proxy in dev) ---
KC_HTTP_RELATIVE_PATH=/
